node_modules/
.env
*.db
*.db-journal
.DS_Store

# local assistant session state — transcripts and machine-specific config,
# not part of the project
.claude/

# scratch output from tools/probe.js, tools/probe-all.js, tools/sniff.js —
# regenerate any time, never worth committing
tools/output/

# data/manual/*.json is tracked, deliberately — see git history for why this
# line used to ignore it. It looked like "personal, like the DB" but isn't:
# these are public job advertisements copied by hand from a company's own
# careers page (Rafael, behind Reblaze bot protection) — the input to a
# public listing, not personal data. Ignoring it meant the scheduled scrape
# workflow (which checks out from git) could never see the file and failed on
# every single run. The line that actually belongs here draws the real
# boundary: personal vs. public, not data vs. code.
